                <mxCell id="4" value="DIAGRAMA DE PLAN PARA OBTENER INGRESOS CON MI IDEA" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
