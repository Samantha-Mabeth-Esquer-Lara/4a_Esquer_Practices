                <mxCell id="5" value="Desarrollar mi sitio web, ponerlo en funcionamiento y desplegarlo en internet." style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="160" y="120" width="160" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="6" value="Publicitarlo en los sitios adecuados para atraer al público objetivo&lt;span style=&quot;font-family: monospace; font-size: 0px; text-align: start; white-space: nowrap;&quot;&gt;%3CmxGraphModel%3E%3Croot%3E%3CmxCell%20id%3D%220%22%2F%3E%3CmxCell%20id%3D%221%22%20parent%3D%220%22%2F%3E%3CmxCell%20id%3D%222%22%20value%3D%22Desarrollar%20mi%20sitio%20web%2C%20ponerlo%20en%20funcionamiento%20y%20desplegarlo%20en%20internet.%22%20style%3D%22rounded%3D0%3BwhiteSpace%3Dwrap%3Bhtml%3D1%3B%22%20vertex%3D%221%22%20parent%3D%221%22%3E%3CmxGeometry%20x%3D%22160%22%20y%3D%22120%22%20width%3D%22170%22%20height%3D%2280%22%20as%3D%22geometry%22%2F%3E%3C%2FmxCell%3E%3C%2Froot%3E%3C%2FmxGraphModel%3E&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="160" y="240" width="160" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="7" value="Una vez tenga mi público objetivo, separarlo en dos tipos" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="160" y="360" width="160" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="8" value="¿Cliente&lt;div&gt;o&lt;/div&gt;&lt;div&gt;proveedor?&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="180" y="480" width="120" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="9" value="Pueden crear su cuenta siempre y cuando cumpla con los requisitos minimos.&lt;div&gt;Libre de navegar por el sitio sin problema.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="160" y="640" width="160" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="10" value="Debe de pagar una suscripción para poder anunciarse en el sitio web, dependiendo del tipo de suscripción se le da más alcance." style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
